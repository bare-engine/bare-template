{
    "name": "template-bare",
    "version": "1.2.1",
    "scripts": {
        "generate:layers": "node webpack/generate-layers.js",
        "generate:layers:watch": "node webpack/generate-layers.js --watch",
        "dev": "webpack-dev-server --config webpack/config.dev.js",
        "dev:open": "webpack-dev-server --config webpack/config.dev.js --open",
        "build": "webpack --config webpack/config.prod.js",
        "build-zip": "npm run build && cd dist && bestzip ../dist.zip *",
        "dev-nolog": "webpack-dev-server --config webpack/config.dev.js --open",
        "build-nolog": "npm run generate:layers && webpack --config webpack/config.prod.js",
        "analyze": "webpack --config webpack/config.prod.js --env analyze --json=stats.json && webpack-bundle-analyzer stats.json",
        "poki-upload": "poki upload",
        "build:assets": "assetpack --config assetpack.config.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BareEngine/Template.git"
    },
    "author": "Jeroen Wimmers",
    "license": "MIT",
    "devDependencies": {
		"@assetpack/core": "^1.7.0",
        "@babel/core": "^7.24.5",
        "@babel/preset-env": "^7.24.5",
        "@types/webpack-env": "^1.18.8",
        "babel-loader": "^9.1.3",
        "bestzip": "^2.2.1",
        "clean-webpack-plugin": "^4.0.0",
        "compression-webpack-plugin": "^11.1.0",
        "copy-webpack-plugin": "^12.0.2",
        "esbuild": "^0.27.2",
        "esbuild-loader": "^4.4.2",
        "file-loader": "^6.2.0",
        "fork-ts-checker-webpack-plugin": "^9.0.2",
        "html-replace-webpack-plugin": "^2.6.0",
        "html-webpack-plugin": "^5.6.0",
        "raw-loader": "^4.0.2",
        "terser-webpack-plugin": "^5.3.10",
        "ts-loader": "^9.5.1",
        "typescript": "^5.4.5",
        "webpack": "^5.95.0",
        "webpack-bundle-analyzer": "^4.10.2",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.1.0",
        "webpack-merge": "^5.10.0"
    },
    "dependencies": {
		"bare-engine": "file:../BareEngine"
    }
}
